{
  "name": "pdf-decomposer",
  "version": "1.5.8",
  "description": "Split PDFs into multiple smaller PDFs by visual page selection",
  "main": "./out/main/index.js",
  "author": "PDF Decomposer",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build-demo-pdf.cjs && electron-vite build",
    "build-demo-pdf": "node scripts/build-demo-pdf.cjs",
    "dev": "node scripts/build-demo-pdf.cjs && GTK_THEME=Adwaita:dark electron-vite dev",
    "dist": "node scripts/build-demo-pdf.cjs && electron-vite build && electron-builder",
    "dist:win": "node scripts/build-demo-pdf.cjs && electron-vite build && electron-builder --win",
    "format": "prettier --write .",
    "knip": "knip",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "postinstall": "electron-builder install-app-deps",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@fontsource/inter": "^5.2.8",
    "electron-window-state": "^5.0.3",
    "framer-motion": "^11.15.0",
    "immer": "^11.1.4",
    "lucide-react": "^1.14.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.9.155",
    "react": "^19.0.0",
    "react-colorful": "^5.6.1",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.0.6",
    "@types/electron-window-state": "^2.0.34",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^41.0.2",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "knip": "^5.86.0",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^7.3.5",
    "vitest": "^4.1.10"
  }
}
